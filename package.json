{
  "name": "ngx-loading-overlay",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build @shaman-apprentice/ngx-loading-overlay",
    "watch": "ng build @shaman-apprentice/ngx-loading-overlay --watch --configuration development",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config testConfig/jest.config.ts",
    "publishLib": "npm run build && npm publish ./dist/ngx-loading-overlay --access=public"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^19.2.9",
    "@angular/cdk": "^19.2.14",
    "@angular/common": "^19.2.9",
    "@angular/compiler": "^19.2.9",
    "@angular/core": "^19.2.9",
    "@angular/platform-browser": "^19.2.9",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.10",
    "@angular/cli": "^19.2.10",
    "@angular/compiler-cli": "^19.2.9",
    "@testing-library/angular": "^17.3.7",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.5.5",
    "ng-packagr": "^19.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  }
