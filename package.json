{
  "name": "ngx-loading-overlay",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build @shaman-apprentice/ngx-loading-overlay",
    "watch": "ng build @shaman-apprentice/ngx-loading-overlay --watch --configuration development",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config testConfig/jest.config.ts",
    "publishLib": "npm run test && npm run build && npm publish ./dist/ngx-loading-overlay --access=public"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^20.1.2",
    "@angular/cdk": "^20.1.2",
    "@angular/common": "^20.1.2",
    "@angular/compiler": "^20.1.2",
    "@angular/core": "^20.1.2",
    "@angular/platform-browser": "^20.1.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.1.1",
    "@angular/cli": "^20.1.1",
    "@angular/compiler-cli": "^20.1.2",
    "@testing-library/angular": "^17.4.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.5.5",
    "ng-packagr": "^20.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  }
}